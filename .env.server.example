# Docker Compose interpolation values
CONTENT_INTELLIGENCE_API_PORT=3001
SHARED_DOCKER_NETWORK=iam-crm-backend_default

# The API container reaches existing services through the shared Docker network.
DATABASE_URL="postgresql://content_intelligence_app:CHANGE_ME@iam-crm-backend-db-1:5432/content_intelligence?schema=public"
MIGRATION_DATABASE_URL="postgresql://content_intelligence_app:CHANGE_ME@iam-crm-backend-db-1:5432/content_intelligence?schema=public"

JWT_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="30d"
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAME_SITE=lax
REFRESH_TOKEN_COOKIE_PATH=/api/auth

CORS_ORIGINS=http://localhost:5173,http://SERVER_IP_OR_DOMAIN:8082
CORS_CREDENTIALS=true
BACKEND_PUBLIC_URL="http://SERVER_IP_OR_DOMAIN:3001"
FRONTEND_SSO_CALLBACK_URL="http://SERVER_IP_OR_DOMAIN:8082/auth/sso/callback"

THROTTLE_TTL=60000
THROTTLE_LIMIT=100

SSO_SECRET_ENCRYPTION_KEY="CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
SSO_TICKET_TTL=120

WEBAUTHN_RP_NAME="Content Intelligence"
WEBAUTHN_RP_ID="SERVER_IP_OR_DOMAIN"
WEBAUTHN_ORIGIN="http://SERVER_IP_OR_DOMAIN:8082"

ATTACHMENT_STORAGE_DRIVER=minio
MAX_ATTACHMENT_SIZE_BYTES=26214400
S3_ENDPOINT=http://iam-crm-minio:9000
S3_REGION=us-east-1
S3_BUCKET=content-intelligence-attachments
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true

NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_SCHEDULER_INTERVAL_MINUTES=5
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_MS=5000
NOTIFICATION_WORKER_BATCH_SIZE=50
NOTIFICATION_RETRY_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_DELAY_SECONDS=30
NOTIFICATION_RETRY_MAX_DELAY_SECONDS=3600
NOTIFICATION_PROCESSING_LEASE_SECONDS=300

{
  "name": "iam-crm-backend",
  "version": "0.1.0",
  "description": "بک‌اند سیستم مدیریت فرآیند فروش IAM - از تحقیق شرکت تا پایپ‌لاین فروش",
  "private": true,
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "lint": "eslint \"src/**/*.ts\" \"prisma/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"prisma/**/*.ts\" \"test/**/*.ts\" --fix",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "safety:scan-migrations": "node tools/migration-safety/cli.cjs scan-migrations",
    "safety:inventory": "node tools/migration-safety/cli.cjs inventory",
    "safety:backup:dry-run": "node tools/migration-safety/cli.cjs backup --dry-run",
    "membership:preflight": "node dist/src/organization-memberships/membership-maintenance.js preflight",
    "membership:backfill:dry-run": "node dist/src/organization-memberships/membership-maintenance.js backfill --dry-run",
    "membership:backfill": "node dist/src/organization-memberships/membership-maintenance.js backfill",
    "membership:validate": "node dist/src/organization-memberships/membership-maintenance.js validate",
    "tenant-constraints:preflight": "node dist/src/tenant-constraints/tenant-constraints-maintenance.js preflight",
    "tenant-constraints:backfill:dry-run": "node dist/src/tenant-constraints/tenant-constraints-maintenance.js backfill --dry-run",
    "tenant-constraints:backfill": "node dist/src/tenant-constraints/tenant-constraints-maintenance.js backfill",
    "tenant-constraints:validate": "node dist/src/tenant-constraints/tenant-constraints-maintenance.js validate",
    "rls:verify-pool": "node tools/rls/verify-pool.cjs",
    "platform-admin:preflight": "node dist/src/platform-authority/platform-authority-maintenance.js preflight",
    "platform-admin:grant": "node dist/src/platform-authority/platform-authority-maintenance.js grant",
    "platform-admin:revoke": "node dist/src/platform-authority/platform-authority-maintenance.js revoke",
    "platform-admin:validate": "node dist/src/platform-authority/platform-authority-maintenance.js validate",
    "tenant-onboarding:preflight": "node dist/src/organizations/tenant-onboarding-maintenance.js preflight",
    "tenant-onboarding:validate": "node dist/src/organizations/tenant-onboarding-maintenance.js validate",
    "tenant-configuration:preflight": "node dist/src/organizations/tenant-configuration-maintenance.js preflight",
    "tenant-configuration:backfill:dry-run": "node dist/src/organizations/tenant-configuration-maintenance.js backfill",
    "tenant-configuration:backfill": "node dist/src/organizations/tenant-configuration-maintenance.js backfill --confirm-apply",
    "tenant-configuration:validate": "node dist/src/organizations/tenant-configuration-maintenance.js validate",
    "sso-tenant:preflight": "node dist/src/auth/sso/sso-tenant-maintenance.js preflight",
    "sso-tenant:backfill:dry-run": "node dist/src/auth/sso/sso-tenant-maintenance.js backfill",
    "sso-tenant:backfill": "node dist/src/auth/sso/sso-tenant-maintenance.js backfill",
    "sso-tenant:validate": "node dist/src/auth/sso/sso-tenant-maintenance.js validate",
    "tenant-rbac:preflight": "node dist/src/organization-memberships/tenant-rbac-maintenance.js preflight",
    "tenant-rbac:backfill:dry-run": "node dist/src/organization-memberships/tenant-rbac-maintenance.js backfill --dry-run",
    "tenant-rbac:backfill": "node dist/src/organization-memberships/tenant-rbac-maintenance.js backfill --confirm-apply",
    "tenant-rbac:validate": "node dist/src/organization-memberships/tenant-rbac-maintenance.js validate",
    "entitlements:preflight": "node dist/src/entitlements/entitlement-maintenance.js preflight",
    "entitlements:bootstrap:dry-run": "node dist/src/entitlements/entitlement-maintenance.js bootstrap",
    "entitlements:bootstrap": "node dist/src/entitlements/entitlement-maintenance.js bootstrap --confirm-apply",
    "entitlements:backfill:dry-run": "node dist/src/entitlements/entitlement-maintenance.js backfill",
    "entitlements:backfill": "node dist/src/entitlements/entitlement-maintenance.js backfill --confirm-apply",
    "entitlements:validate": "node dist/src/entitlements/entitlement-maintenance.js validate",
    "quota:preflight": "node dist/src/quota/quota-maintenance.js preflight",
    "quota:bootstrap:dry-run": "node dist/src/quota/quota-maintenance.js bootstrap",
    "quota:bootstrap": "node dist/src/quota/quota-maintenance.js bootstrap --confirm-apply",
    "quota:backfill:dry-run": "node dist/src/quota/quota-maintenance.js backfill",
    "quota:backfill": "node dist/src/quota/quota-maintenance.js backfill --confirm-apply",
    "quota:reconcile:dry-run": "node dist/src/quota/quota-maintenance.js reconcile",
    "quota:reconcile": "node dist/src/quota/quota-maintenance.js reconcile --confirm-apply",
    "quota:validate": "node dist/src/quota/quota-maintenance.js validate",
    "audit-v2:preflight": "node dist/src/audit-log/audit-log-maintenance.js preflight",
    "audit-v2:backfill:dry-run": "node dist/src/audit-log/audit-log-maintenance.js backfill",
    "audit-v2:backfill": "node dist/src/audit-log/audit-log-maintenance.js backfill --confirm-apply",
    "audit-v2:validate": "node dist/src/audit-log/audit-log-maintenance.js validate",
    "audit-v2:archive:dry-run": "node dist/src/audit-log/audit-log-maintenance.js archive",
    "audit-v2:archive": "node dist/src/audit-log/audit-log-maintenance.js archive --confirm-apply",
    "audit-v2:retention:dry-run": "node dist/src/audit-log/audit-log-maintenance.js retention",
    "openapi:generate": "npm run build && node dist/src/openapi/generate-openapi.js",
    "openapi:validate": "redocly lint openapi/openapi.json --config redocly.yaml",
    "openapi:check": "npm run openapi:generate && npm run openapi:validate && npm run test:contract",
    "openapi:breaking": "node tools/openapi/check-breaking.cjs",
    "openapi:response-coverage": "node tools/openapi/response-coverage.cjs",
    "test:contract": "jest --runInBand test/openapi-contract.spec.ts test/openapi-determinism.spec.ts test/openapi-breaking-change.spec.ts test/openapi-typed-responses.spec.ts test/quota-openapi-contract.spec.ts",
    "ci": "npm run prisma:generate && npm run lint && npm run test && npm run build && npm run openapi:generate && npm run openapi:validate && npm run test:contract"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1084.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@node-saml/node-saml": "^5.1.0",
    "@prisma/client": "^5.19.0",
    "@simplewebauthn/server": "^13.3.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.2.0",
    "joi": "^18.2.3",
    "multer": "^2.2.0",
    "node-cache": "^5.1.2",
    "nodemailer": "^10.0.0",
    "openid-client": "5.7.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^5.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@redocly/cli": "^1.34.19",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "@types/node-cache": "^4.1.3",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "openapi-diff": "^0.24.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  }
}

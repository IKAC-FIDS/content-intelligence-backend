// ============================================================
// IAM Sales CRM - Database Schema (نسخه نهایی با ماژولار Industry)
// ============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

enum UserRole {
  ADMIN
  MANAGER
  REP
  BOARDS
}

enum PlatformRole {
  PLATFORM_ADMIN
}

enum RoleScope {
  SYSTEM
  TENANT
}

enum FeatureKey {
  SSO
  PASSKEY
  ADVANCED_RBAC
  CUSTOM_DOMAINS
  BRANDING
  AUDIT
  REPORTING
}

enum SubscriptionType {
  STANDARD
  TRIAL
  MANUAL_CONTRACT
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum EntitlementOverrideState {
  ENABLED
  DISABLED
}

enum QuotaMetric {
  ACTIVE_USERS
  COMPANIES
  OPPORTUNITIES
  FILES
  STORAGE_BYTES
  API_CALLS
  WORKFLOW_RUNS
  WEBHOOK_DELIVERIES
  EMAIL_SENDS
  AI_REQUESTS
}

enum QuotaResetPeriod {
  NONE
  DAILY
  MONTHLY
  SUBSCRIPTION_TERM
}

enum UsageReservationStatus {
  RESERVED
  COMMITTED
  RELEASED
  EXPIRED
}

enum SsoProviderType {
  OIDC
  SAML
}

enum SsoRoutingKind {
  DOMAIN
  SUBDOMAIN
}

enum LegacyPipelineStage {
  LEAD
  CONTACTED
  INTERESTED
  QUALIFIED
  NEEDS_ASSESSMENT
  PENDING_PRE_INVOICE_APPROVAL
  POC_PILOT_SCHEDULED
  POC_PILOT_IN_PROGRESS
  PENDING_POC_PILOT_APPROVAL
  PENDING_PAYMENT_INVOICE_APPROVAL
  INSTALLATION_SCHEDULED
  INSTALLATION_IN_PROGRESS
  PENDING_CUSTOMER_ACCEPTANCE
  DONE
  ON_HOLD
  LOST
  NO_RESPONSE

  @@map("PipelineStage")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  STRATEGIC
}

enum CompanyOwnership {
  PRIVATE
  STATE
  SEMI_STATE
  PUBLIC_LISTED
  BANK
  HOLDING
}

enum CompanyActivityStatus {
  ACTIVE
  INACTIVE
  MERGED
  UNKNOWN
}

enum CompanyLegalDocumentType {
  OFFICIAL_GAZETTE
  LATEST_CHANGES
}

enum PersonEducationDegree {
  DIPLOMA
  ASSOCIATE
  BACHELOR
  PHD
  POSTDOC
}

enum ActivityType {
  CALL
  EMAIL
  LINKEDIN_MESSAGE
  LINKEDIN_ENGAGEMENT
  MEETING
  NOTE
  STAGE_CHANGE
}

enum SocialPlatform {
  LINKEDIN
  INSTAGRAM
  TELEGRAM
  BALE
  EITAA
  SOROUSH
  ROOBIKA
  APARAT
  YOUTUBE
  WEBSITE
}

enum CommercialDocumentType {
  PROPOSAL
  PROFORMA
  CONTRACT
}

enum CommercialDocumentStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  SIGNED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHECK
  CARD
  OTHER
}

enum FileAttachmentEntityType {
  COMPANY
  OPPORTUNITY
  PERSON
  TASK
  ACTIVITY
  COMMERCIAL_DOCUMENT
  PAYMENT
  COMPANY_LEGAL_DOCUMENT
  MEETING
  PRODUCT
  ORGANIZATION
  TECHNICAL_DOCUMENT
  TECHNICAL_RESOURCE
}

enum AttachmentStorageProvider {
  LOCAL
  MINIO
}

enum ArtifactType {
  FILE
  EXTERNAL_URL
}

enum ArtifactProvider {
  LOCAL
  OBJECT_STORAGE
  GOOGLE_DRIVE
  SHAREPOINT
  ONEDRIVE
  GITHUB
  GENERIC_URL
}

enum ArtifactRelationType {
  ATTACHMENT
  PROPOSAL
  CONTRACT
  TECHNICAL_DOCUMENT
  MEETING_MINUTES
  SCREENSHOT
  EVIDENCE
  REFERENCE
  OTHER
}

enum ActivityTargetType {
  COMPANY
  TASK
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskReviewStatus {
  NOT_REQUIRED
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
}

enum TaskReviewDecision {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  CANCELLED
}

enum TaskAssignmentScope {
  SELF
  TEAM
  ORGANIZATION
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum MeetingMode {
  IN_PERSON
  ONLINE
  HYBRID
}

enum PricingCurrency {
  IRR
  USD
}

enum SalesChannel {
  LEGACY_UNKNOWN
  IN_PERSON
  DIGIKALA
  OTHER
}

enum ProductPriceHistoryReason {
  MIGRATION_BASELINE
  PRODUCT_CREATED
  PRODUCT_UPDATED
  EXCHANGE_RATE_CHANGED
  MANUAL_RECALCULATION
}

enum NotificationType {
  SYSTEM
  TASK_CREATED
  TASK_ASSIGNED
  TASK_STATUS_CHANGED
  TASK_COMPLETED
  TASK_RESCHEDULED
  OPPORTUNITY_UPDATED
  COMMERCIAL_DOCUMENT_UPDATED
  PAYMENT_UPDATED
  ATTACHMENT_UPLOADED
  MEETING_REMINDER
  TENDER_WORKFLOW
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
  CRITICAL
}

enum NotificationEntityType {
  TASK
  COMPANY
  PERSON
  OPPORTUNITY
  COMMERCIAL_DOCUMENT
  PAYMENT
  ATTACHMENT
  MEETING
  TENDER
}

enum OrganizationStatus {
  PENDING_SETUP
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationOnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  READY
  FAILED
}

enum OrganizationMembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum OrganizationCalendarSystem {
  GREGORIAN
  PERSIAN
}

enum OrganizationDateFormat {
  YYYY_MM_DD
  DD_MM_YYYY
  MM_DD_YYYY
}

enum OrganizationDomainType {
  SUBDOMAIN
  CUSTOM
}

enum OrganizationDomainStatus {
  PENDING
  VERIFIED
  FAILED
  DISABLED
}

enum OrganizationDomainVerificationMethod {
  DNS_TXT
}

enum ConversationEntityType {
  COMPANY
  TASK
  ACTIVITY
}

enum ConversationMessageType {
  COMMENT
  QUESTION
  ANSWER
}

enum ConversationThreadStatus {
  OPEN
  RESOLVED
}

// ============================================================
// Users & Auth
// ============================================================

model User {
  id                    String                     @id @default(uuid())
  fullName              String
  email                 String                     @unique
  passwordHash          String
  role                  UserRole                   @default(REP)
  roleId                String?
  assignedRole          Role?                      @relation(fields: [roleId], references: [id], onDelete: SetNull)
  team                  String?
  teamId                String?
  teamRef               Team?                      @relation("UserPrimaryTeam", fields: [teamId], references: [id], onDelete: SetNull)
  isActive              Boolean                    @default(true)
  avatarStorageProvider AttachmentStorageProvider?
  avatarBucket          String?
  avatarObjectKey       String?
  avatarStoragePath     String?
  avatarMimeType        String?
  avatarOriginalName    String?

  organizationId String       @default("00000000-0000-4000-8000-000000000001")
  organization   Organization @relation(fields: [organizationId], references: [id])

  passwordChangedAt   DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedCompanies          Company[]                 @relation("CompanyOwner")
  archivedCompanies       Company[]                 @relation("CompanyArchivedBy")
  ownedOpportunities      Opportunity[]             @relation("OpportunityOwner")
  archivedOpportunities   Opportunity[]             @relation("OpportunityArchivedBy")
  opportunityStageChanges OpportunityStageHistory[]
  activities              Activity[]
  completedActivities     Activity[]                @relation("ActivityCompletedBy")
  stageChangesMade        PipelineStageHistory[]
  passkeys                UserPasskey[]
  externalIdentities      ExternalIdentity[]
  ssoLoginTickets         SsoLoginTicket[]
  refreshSessions         RefreshSession[]

  assignedTasks        Task[]            @relation("TaskAssignedTo")
  createdTasks         Task[]            @relation("TaskCreatedBy")
  completedTasks       Task[]            @relation("TaskCompletedBy")
  tasksToReview        Task[]            @relation("TaskReviewer")
  taskReviewsAssigned  TaskReviewRound[] @relation("TaskReviewReviewer")
  taskReviewsSubmitted TaskReviewRound[] @relation("TaskReviewSubmittedBy")

  organizedMeetings      Meeting[]              @relation("MeetingOrganizer")
  createdMeetings        Meeting[]              @relation("MeetingCreatedBy")
  completedMeetings      Meeting[]              @relation("MeetingCompletedBy")
  cancelledMeetings      Meeting[]              @relation("MeetingCancelledBy")
  meetingAssignments     MeetingAssignee[]      @relation("MeetingAssignedUser")
  meetingAssignmentsMade MeetingAssignee[]      @relation("MeetingAssignedBy")
  exchangeRatesCreated   CurrencyExchangeRate[] @relation("ExchangeRateCreatedBy")
  productPriceChanges    ProductPriceHistory[]  @relation("ProductPriceHistoryChangedBy")

  notifications                     Notification[]             @relation("NotificationRecipient")
  notificationActions               Notification[]             @relation("NotificationActor")
  managedTeams                      Team[]                     @relation("TeamManager")
  organizationMemberships           OrganizationMembership[]
  technicalReleasesCreated          TechnicalRelease[]         @relation("TechnicalReleaseCreatedBy")
  technicalReleasesUpdated          TechnicalRelease[]         @relation("TechnicalReleaseUpdatedBy")
  knowledgeArticlesOwned            KnowledgeBaseArticle[]     @relation("KnowledgeArticleOwner")
  knowledgeArticlesAuthored         KnowledgeBaseArticle[]     @relation("KnowledgeArticleAuthor")
  knowledgeArticlesReviewed         KnowledgeBaseArticle[]     @relation("KnowledgeArticleReviewer")
  technicalDocumentsOwned           TechnicalDocument[]        @relation("TechnicalDocumentOwner")
  technicalDocumentsCreated         TechnicalDocument[]        @relation("TechnicalDocumentCreatedBy")
  technicalDocumentsUpdated         TechnicalDocument[]        @relation("TechnicalDocumentUpdatedBy")
  technicalDocumentVersionsCreated  TechnicalDocumentVersion[] @relation("TechnicalDocumentVersionCreatedBy")
  technicalDocumentVersionsApproved TechnicalDocumentVersion[] @relation("TechnicalDocumentVersionApprovedBy")
  technicalResourcesOwned           TechnicalResource[]        @relation("TechnicalResourceOwner")
  technicalResourcesCreated         TechnicalResource[]        @relation("TechnicalResourceCreatedBy")
  technicalResourcesUpdated         TechnicalResource[]        @relation("TechnicalResourceUpdatedBy")
  technicalTendersOwned             Tender[]                   @relation("TechnicalTenderOwner")
  technicalTendersLed               Tender[]                   @relation("TechnicalTenderTechnicalLead")
  commercialTendersLed              Tender[]                   @relation("TechnicalTenderCommercialLead")
  technicalTendersSubmitted         Tender[]                   @relation("TechnicalTenderSubmittedBy")
  technicalTendersClosed            Tender[]                   @relation("TechnicalTenderClosedBy")
  technicalTendersCreated           Tender[]                   @relation("TechnicalTenderCreatedBy")
  technicalTendersUpdated           Tender[]                   @relation("TechnicalTenderUpdatedBy")
  tenderRequirementsOwned           TenderRequirement[]        @relation("TenderRequirementOwner")
  tenderRequirementsBlocked         TenderRequirement[]        @relation("TenderRequirementBlockedBy")
  tenderReviewsAssigned             TenderReview[]             @relation("TenderReviewReviewer")
  tenderReviewsRequested            TenderReview[]             @relation("TenderReviewRequestedBy")
  tenderReviewsDecided              TenderReview[]             @relation("TenderReviewDecidedBy")
  artifactsUploaded                 FileAttachment[]           @relation("ArtifactUploadedBy")
  artifactsDeleted                  FileAttachment[]           @relation("ArtifactDeletedBy")
  artifactLinksCreated              ArtifactLink[]             @relation("ArtifactLinkCreatedBy")
  taskReviewArtifactsAdded          TaskReviewArtifact[]       @relation("TaskReviewArtifactAddedBy")
  platformAuthority                 PlatformAuthority?

  notificationCoreEventActions  NotificationEvent[]           @relation("NotificationCoreEventActor")
  notificationCoreDeliveries    NotificationDelivery[]        @relation("NotificationCoreDeliveryRecipient")
  notificationRetriesRequested  NotificationDelivery[]        @relation("NotificationDeliveryRetryRequestedBy")
  notificationAttemptsTriggered NotificationDeliveryAttempt[] @relation("NotificationDeliveryAttemptTriggeredBy")
  notificationCorePreferences   NotificationPreference[]      @relation("NotificationCorePreferences")
  notificationPushEndpoints     NotificationPushEndpoint[]
  conversationThreadsCreated    ConversationThread[]          @relation("ConversationThreadCreatedBy")
  conversationMessagesAuthored  ConversationMessage[]         @relation("ConversationMessageAuthor")
  conversationMessagesDeleted   ConversationMessage[]         @relation("ConversationMessageDeletedBy")
  conversationParticipants      ConversationParticipant[]

  @@index([organizationId])
  @@index([teamId])
  @@index([roleId])
  @@map("users")
}

model Team {
  id          String  @id @default(uuid())
  code        String
  name        String
  description String?

  managerId String?
  manager   User?   @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  members                 User[]                   @relation("UserPrimaryTeam")
  organizationMemberships OrganizationMembership[]
  technicalTenders        Tender[]
  tasks                   Task[]

  @@unique([organizationId, code])
  @@index([managerId])
  @@index([isActive])
  @@index([organizationId])
  @@map("teams")
}

model Organization {
  id String @id @default(uuid())

  code String @unique
  name String

  status           OrganizationStatus           @default(ACTIVE)
  onboardingStatus OrganizationOnboardingStatus @default(NOT_STARTED)

  onboardingStartedAt      DateTime?
  onboardingCompletedAt    DateTime?
  onboardingLastAttemptAt  DateTime?
  onboardingFailureCode    String?
  onboardingFailureMessage String?

  timezone String @default("Asia/Tehran")
  locale   String @default("fa-IR")

  settings             Json?
  authorizationVersion Int   @default(1)
  entitlementVersion   Int   @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  teams                Team[]
  companies            Company[]
  opportunities        Opportunity[]
  tasks                Task[]
  notifications        Notification[]
  fileAttachments      FileAttachment[]
  artifactLinks        ArtifactLink[]
  taskReviewRounds     TaskReviewRound[]
  auditLogs            AuditLog[]
  meetings             Meeting[]
  conversationThreads  ConversationThread[]
  conversationMessages ConversationMessage[]
  memberships          OrganizationMembership[]
  ssoProviders         SsoProvider[]
  ssoRoutes            SsoProviderRoute[]
  ssoAuthTransactions  SsoAuthTransaction[]
  tenantSettings       OrganizationSettings?
  branding             OrganizationBranding?
  domains              OrganizationDomain[]
  tenantRoles          Role[]                      @relation("TenantRoles")
  subscriptions        Subscription[]
  entitlements         OrganizationEntitlement[]
  quotaOverrides       OrganizationQuotaOverride[]
  usageCounters        UsageCounter[]
  usageSnapshots       UsageSnapshot[]
  quotaThresholds      QuotaThresholdEvent[]
  usageReservations    UsageReservation[]
  usageEvents          UsageEvent[]
  technicalReleases    TechnicalRelease[]
  knowledgeArticles    KnowledgeBaseArticle[]
  technicalDocuments   TechnicalDocument[]
  technicalResources   TechnicalResource[]
  tenders              Tender[]
  tenderReviews        TenderReview[]

  notificationCoreEvents       NotificationEvent[]            @relation("NotificationCoreEvents")
  notificationCoreRules        NotificationRule[]             @relation("NotificationCoreRules")
  notificationSchedules        NotificationSchedule[]         @relation("NotificationSchedules")
  notificationCoreTemplates    NotificationTemplate[]         @relation("NotificationCoreTemplates")
  notificationCoreDeliveries   NotificationDelivery[]         @relation("NotificationCoreDeliveryOrganization")
  notificationDeliveryAttempts NotificationDeliveryAttempt[]  @relation("NotificationDeliveryAttemptOrganization")
  notificationCorePreferences  NotificationPreference[]       @relation("NotificationCorePreferences")
  notificationSmsSettings      NotificationSmsSettings?
  notificationPushSettings     NotificationPushSettings?
  notificationPushEndpoints    NotificationPushEndpoint[]
  notificationQuietHours       NotificationQuietHoursPolicy?
  notificationDigestPolicies   NotificationDigestPolicy[]
  notificationDigestBuckets    NotificationDigestBucket[]
  notificationEscalations      NotificationEscalationPolicy[]
  notificationEscalationRuns   NotificationEscalationRun[]

  @@index([status])
  @@index([createdAt])
  @@map("organizations")
}

model OrganizationSettings {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  timezone               String                     @default("Asia/Tehran")
  locale                 String                     @default("fa-IR")
  calendarSystem         OrganizationCalendarSystem @default(PERSIAN)
  dateFormat             OrganizationDateFormat     @default(YYYY_MM_DD)
  firstDayOfWeek         Int                        @default(6)
  emailSenderDisplayName String?
  smtpEnabled            Boolean                    @default(false)
  smtpHost               String?
  smtpPort               Int?
  smtpSecure             Boolean                    @default(true)
  smtpUsername           String?
  smtpPasswordEnc        String?
  smtpFromEmail          String?
  smtpFromName           String?
  smtpReplyTo            String?
  allowPasswordLogin     Boolean                    @default(true)
  allowPasskeyLogin      Boolean                    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organization_settings")
}

model OrganizationBranding {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  displayTitle        String?
  primaryColor        String?
  secondaryColor      String?
  accentColor         String?
  logoAttachmentId    String?
  faviconAttachmentId String?
  logoAttachment      FileAttachment? @relation("OrganizationBrandingLogo", fields: [logoAttachmentId], references: [id], onDelete: SetNull)
  faviconAttachment   FileAttachment? @relation("OrganizationBrandingFavicon", fields: [faviconAttachmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([logoAttachmentId])
  @@index([faviconAttachmentId])
  @@map("organization_branding")
}

model OrganizationDomain {
  id                    String                               @id @default(uuid())
  organizationId        String
  organization          Organization                         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type                  OrganizationDomainType
  hostname              String                               @unique
  subdomainLabel        String?                              @unique
  status                OrganizationDomainStatus             @default(PENDING)
  verificationMethod    OrganizationDomainVerificationMethod @default(DNS_TXT)
  verificationTokenHash String
  verifiedAt            DateTime?
  lastCheckedAt         DateTime?
  failureCode           String?
  createdAt             DateTime                             @default(now())
  updatedAt             DateTime                             @updatedAt

  @@index([organizationId, status])
  @@index([status, hostname])
  @@map("organization_domains")
}

model UserPasskey {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId         String    @unique
  credentialPublicKey  Bytes
  counter              Int       @default(0)
  deviceName           String?
  transports           String[]
  backedUp             Boolean   @default(false)
  credentialDeviceType String?
  lastUsedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
  @@map("user_passkeys")
}

model SsoProvider {
  id       String          @id @default(uuid())
  name     String
  type     SsoProviderType
  isActive Boolean         @default(true)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  normalizedName String?

  autoProvision  Boolean   @default(false)
  defaultRole    UserRole?
  allowedDomains String[]  @default([])

  // OIDC configuration
  issuer           String?
  clientId         String?
  clientSecretEnc  String?
  authorizationUrl String?
  tokenUrl         String?
  userInfoUrl      String?
  jwksUrl          String?
  scopes           String[] @default(["openid", "profile", "email"])

  // SAML configuration
  entityId             String?
  ssoUrl               String?
  x509Certificate      String?
  signRequests         Boolean @default(false)
  wantAssertionsSigned Boolean @default(true)
  wantResponseSigned   Boolean @default(false)

  // Attribute mapping
  emailAttribute  String?
  nameAttribute   String?
  groupsAttribute String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  externalIdentities ExternalIdentity[]
  loginTickets       SsoLoginTicket[]
  routes             SsoProviderRoute[]
  groupRoleMappings  SsoGroupRoleMapping[]
  authTransactions   SsoAuthTransaction[]

  @@unique([organizationId, type, normalizedName])
  @@unique([organizationId, issuer])
  @@unique([organizationId, clientId])
  @@unique([organizationId, entityId])
  @@index([type])
  @@index([isActive])
  @@index([organizationId, isActive])
  @@map("sso_providers")
}

model SsoProviderRoute {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerId     String
  provider       SsoProvider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  kind           SsoRoutingKind
  value          String
  createdAt      DateTime       @default(now())

  @@unique([kind, value])
  @@unique([providerId, kind, value])
  @@index([organizationId])
  @@index([providerId])
  @@map("sso_provider_routes")
}

model SsoGroupRoleMapping {
  id              String      @id @default(uuid())
  providerId      String
  provider        SsoProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  normalizedGroup String
  roleId          String
  role            Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([providerId, normalizedGroup])
  @@index([roleId])
  @@map("sso_group_role_mappings")
}

model SsoAuthTransaction {
  id              String       @id @default(uuid())
  stateHash       String       @unique
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerId      String
  provider        SsoProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  nonceEnc        String?
  pkceVerifierEnc String?
  redirectTarget  String
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime     @default(now())

  @@index([providerId, expiresAt])
  @@index([organizationId, expiresAt])
  @@index([consumedAt])
  @@map("sso_auth_transactions")
}

model ExternalIdentity {
  id         String @id @default(uuid())
  userId     String
  providerId String

  subject String
  email   String?

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider SsoProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, subject])
  @@index([userId])
  @@index([email])
  @@map("external_identities")
}

model SsoLoginTicket {
  id         String @id @default(uuid())
  ticketHash String @unique

  userId     String
  providerId String?

  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider SsoProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([providerId])
  @@index([expiresAt])
  @@index([consumedAt])
  @@map("sso_login_tickets")
}

model RefreshSession {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String @unique

  userAgent String?
  ipAddress String?

  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  revokedAt           DateTime?
  revokedReason       String?
  replacedBySessionId String?

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([userId, revokedAt, expiresAt])
  @@map("refresh_sessions")
}

// ============================================================
// Company
// ============================================================

model Company {
  id       String @id @default(uuid())
  leadCode String @unique @default(uuid())

  legalName           String
  brandName           String?
  registrationNo      String?
  registrationNumber  String?
  nationalId          String?
  economicCode        String?
  establishmentDate   DateTime?
  foundedYear         Int?
  companyType         String?
  ownership           CompanyOwnership?
  activityStatus      CompanyActivityStatus      @default(UNKNOWN)
  activityGroup       String?
  marketSize          String?
  logoStorageProvider AttachmentStorageProvider?
  logoBucket          String?
  logoObjectKey       String?
  logoStoragePath     String?
  logoMimeType        String?
  logoOriginalName    String?

  industryId  String?
  industryRef Industry? @relation("CompanyIndustry", fields: [industryId], references: [id], onDelete: SetNull)

  // Deprecated compatibility snapshot. New writes should resolve from Industry.
  industry String?

  parentCompanyId     String?
  parentCompany       Company?                   @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id])
  subsidiaries        Company[]                  @relation("CompanyHierarchy")
  parentRelations     CompanyHierarchyRelation[] @relation("CompanyHierarchyParent")
  subsidiaryRelations CompanyHierarchyRelation[] @relation("CompanyHierarchySubsidiary")

  website            String?
  publicEmail        String?
  headOfficeProvince String?
  headOfficeCity     String?
  headOfficeAddress  String?
  postalCode         String?
  centralPhone       String?

  registeredCapital Decimal? @db.Decimal(24, 2)
  employeeCount     Int?
  annualRevenue     BigInt?

  ownerId String?
  owner   User?   @relation("CompanyOwner", fields: [ownerId], references: [id])

  // Deprecated pipeline compatibility fields. New sales flows belong to Opportunity.
  priority Priority            @default(MEDIUM)
  stage    LegacyPipelineStage @default(LEAD)

  sourceId  String?
  sourceRef LeadSource? @relation("CompanyLeadSource", fields: [sourceId], references: [id], onDelete: SetNull)

  // Deprecated compatibility snapshot. New writes should resolve from LeadSource.
  source         String?   @default("SAM_LIST")
  nextActionDate DateTime?

  archivedAt    DateTime?
  archivedById  String?
  archivedBy    User?     @relation("CompanyArchivedBy", fields: [archivedById], references: [id])
  archiveReason String?

  researchCompletion Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches                CompanyBranch[]
  socialChannels          CompanySocialChannel[]
  people                  Person[]
  activities              Activity[]
  callCard                CallCard?
  stageHistory            PipelineStageHistory[]
  opportunities           Opportunity[]
  tasks                   Task[]
  legalDocuments          CompanyLegalDocument[]
  personEmploymentHistory PersonEmploymentHistory[]
  meetings                Meeting[]
  technicalDocuments      TechnicalDocument[]
  tenders                 Tender[]

  organizationId String       @default("00000000-0000-4000-8000-000000000001")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([ownerId])
  @@index([industryId])
  @@index([sourceId])
  @@index([stage])
  @@index([priority])
  @@index([industry])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([archivedAt])
  @@index([ownerId, stage])
  @@index([stage, priority])
  @@index([organizationId])
  @@index([organizationId, ownerId])
  @@map("companies")
}


// ============================================================
// Activity (فعالیت‌ها)
// ============================================================

model Activity {
  id         String             @id @default(uuid())
  targetType ActivityTargetType @default(COMPANY)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  taskId   String?
  task     Task?   @relation("TaskActivities", fields: [taskId], references: [id], onDelete: SetNull)
  personId String?
  person   Person? @relation(fields: [personId], references: [id])
  userId   String
  user     User    @relation(fields: [userId], references: [id])

  type           String
  notes          String?
  outcome        String?
  occurredAt     DateTime     @default(now())
  nextActionDate DateTime?
  completedAt    DateTime?
  completedById  String?
  completedBy    User?        @relation("ActivityCompletedBy", fields: [completedById], references: [id])
  completionNote String?
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  tasks          Task[]       @relation("LegacyTaskActivity")

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([nextActionDate])
  @@index([completedAt])
  @@index([type])
  @@index([occurredAt])
  @@index([userId, nextActionDate])
  @@index([companyId, occurredAt])
  @@index([opportunityId])
  @@index([targetType])
  @@index([taskId])
  @@index([taskId, occurredAt])
  @@map("activities")
}

model Opportunity {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  ownerId String?
  owner   User?   @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  title       String
  description String?

  stageId  String
  stage    PipelineStage @relation(fields: [stageId], references: [id])
  priority Priority      @default(MEDIUM)

  estimatedValue    Decimal?  @db.Decimal(18, 2)
  expectedCloseDate DateTime?

  sourceOptionId String?
  sourceOption   LookupOption? @relation("OpportunitySourceOption", fields: [sourceOptionId], references: [id], onDelete: SetNull)

  // Backward-compatible snapshot. New writes should prefer sourceOptionId/opportunitySource.
  source String?

  primaryContactId String?
  primaryContact   Person? @relation("OpportunityPrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)

  probability Int?
  competitor  String?
  lostReason  String?
  wonAt       DateTime?
  lostAt      DateTime?

  archivedAt    DateTime?
  archivedById  String?
  archivedBy    User?     @relation("OpportunityArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  archiveReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stageHistories      OpportunityStageHistory[]
  activities          Activity[]
  lineItems           OpportunityLineItem[]
  commercialDocuments OpportunityCommercialDocument[]
  payments            OpportunityPayment[]
  tasks               Task[]
  meetings            Meeting[]
  technicalDocuments  TechnicalDocument[]
  tenders             Tender[]
  organizationId      String                          @default("00000000-0000-4000-8000-000000000001")
  organization        Organization                    @relation(fields: [organizationId], references: [id])

  @@index([companyId])
  @@index([ownerId])
  @@index([stageId])
  @@index([priority])
  @@index([sourceOptionId])
  @@index([primaryContactId])
  @@index([expectedCloseDate])
  @@index([archivedAt])
  @@index([ownerId, stageId])
  @@index([organizationId])
  @@index([organizationId, ownerId])
  @@index([organizationId, stageId])
  @@index([organizationId, sourceOptionId])
  @@map("opportunities")
}

model OpportunityCommercialDocument {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  type   CommercialDocumentType
  status CommercialDocumentStatus @default(DRAFT)

  number  String?
  version Int     @default(1)

  title       String
  description String?

  amount   Decimal? @db.Decimal(18, 2)
  currency String   @default("IRR")

  validUntil DateTime?
  issuedAt   DateTime?
  sentAt     DateTime?
  acceptedAt DateTime?
  rejectedAt DateTime?
  signedAt   DateTime?

  fileUrl     String?
  externalRef String?
  notes       String?

  createdById String?
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments OpportunityPayment[]
  tasks    Task[]

  @@index([opportunityId])
  @@index([type])
  @@index([status])
  @@index([number])
  @@index([createdAt])
  @@map("opportunity_commercial_documents")
}

model OpportunityPayment {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  commercialDocumentId String?
  commercialDocument   OpportunityCommercialDocument? @relation(fields: [commercialDocumentId], references: [id], onDelete: SetNull)

  status PaymentStatus @default(PENDING)

  amount   Decimal @db.Decimal(18, 2)
  currency String  @default("IRR")

  dueDate DateTime?
  paidAt  DateTime?

  method          PaymentMethod?
  referenceNumber String?
  description     String?
  notes           String?

  createdById String?
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@index([opportunityId])
  @@index([commercialDocumentId])
  @@index([status])
  @@index([dueDate])
  @@index([paidAt])
  @@map("opportunity_payments")
}

enum ProductType {
  HARDWARE
  SOFTWARE
}

model ProductCatalogItem {
  id                       String                @id @default(uuid())
  code                     String                @unique
  type                     ProductType           @default(HARDWARE)
  digikalaCode             String?               @unique
  digikalaUrl              String?
  name                     String
  description              String?
  category                 String?
  unit                     String?
  defaultUnitPrice         Decimal               @default(0) @db.Decimal(18, 2)
  currency                 String                @default("IRR")
  pricingCurrency          PricingCurrency       @default(IRR)
  inPersonInputPrice       Decimal               @default(0) @db.Decimal(24, 6)
  digikalaInputPrice       Decimal               @default(0) @db.Decimal(24, 6)
  inPersonProfitPercent    Decimal?              @db.Decimal(7, 3)
  digikalaProfitPercent    Decimal?              @db.Decimal(7, 3)
  inPersonPriceIrr         Decimal               @default(0) @db.Decimal(24, 0)
  digikalaPriceIrr         Decimal               @default(0) @db.Decimal(24, 0)
  calculatedExchangeRateId String?
  calculatedExchangeRate   CurrencyExchangeRate? @relation(fields: [calculatedExchangeRateId], references: [id], onDelete: SetNull)
  priceCalculatedAt        DateTime?
  isActive                 Boolean               @default(true)
  sortOrder                Int                   @default(0)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  lineItems          OpportunityLineItem[]
  priceHistory       ProductPriceHistory[]
  technicalReleases  TechnicalRelease[]
  knowledgeArticles  KnowledgeBaseArticle[]
  technicalDocuments TechnicalDocument[]
  technicalResources TechnicalResource[]
  tasks              Task[]

  @@index([isActive, sortOrder])
  @@index([type, isActive, sortOrder])
  @@index([category])
  @@index([pricingCurrency])
  @@index([calculatedExchangeRateId])
  @@map("product_catalog_items")
}

model CurrencyExchangeRate {
  id                  String                @id @default(uuid())
  baseCurrency        String                @default("USD")
  quoteCurrency       String                @default("IRR")
  rate                Decimal               @db.Decimal(24, 6)
  validFrom           DateTime
  validTo             DateTime?
  createdById         String
  createdBy           User                  @relation("ExchangeRateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  note                String?
  createdAt           DateTime              @default(now())
  products            ProductCatalogItem[]
  productPriceHistory ProductPriceHistory[]

  @@index([baseCurrency, quoteCurrency, validFrom])
  @@index([baseCurrency, quoteCurrency, validTo])
  @@map("currency_exchange_rates")
}

model OpportunityLineItem {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  productId          String?
  product            ProductCatalogItem? @relation(fields: [productId], references: [id], onDelete: SetNull)
  tenderRequirements TenderRequirement[]

  productCodeSnapshot String
  productNameSnapshot String

  description String?

  quantity       Decimal @db.Decimal(18, 2)
  unitPrice      Decimal @db.Decimal(18, 2)
  discountAmount Decimal @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal @default(0) @db.Decimal(18, 2)
  lineTotal      Decimal @db.Decimal(18, 2)

  salesChannel                SalesChannel         @default(IN_PERSON)
  catalogUnitPriceIrrSnapshot Decimal?             @db.Decimal(24, 0)
  productPriceHistoryId       String?
  productPriceHistory         ProductPriceHistory? @relation(fields: [productPriceHistoryId], references: [id], onDelete: SetNull)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([opportunityId])
  @@index([productId])
  @@index([sortOrder])
  @@index([salesChannel])
  @@index([productPriceHistoryId])
  @@index([opportunityId, salesChannel])
  @@map("opportunity_line_items")
}

model ProductPriceHistory {
  id                        String                    @id @default(uuid())
  productId                 String
  product                   ProductCatalogItem        @relation(fields: [productId], references: [id], onDelete: Restrict)
  pricingCurrency           PricingCurrency
  inPersonInputPrice        Decimal                   @db.Decimal(24, 6)
  digikalaInputPrice        Decimal                   @db.Decimal(24, 6)
  inPersonProfitPercent     Decimal?                  @db.Decimal(7, 3)
  digikalaProfitPercent     Decimal?                  @db.Decimal(7, 3)
  inPersonPriceIrr          Decimal                   @db.Decimal(24, 0)
  digikalaPriceIrr          Decimal                   @db.Decimal(24, 0)
  calculatedExchangeRateId  String?
  calculatedExchangeRate    CurrencyExchangeRate?     @relation(fields: [calculatedExchangeRateId], references: [id], onDelete: SetNull)
  exchangeRateValueSnapshot Decimal?                  @db.Decimal(24, 6)
  reason                    ProductPriceHistoryReason
  validFrom                 DateTime
  validTo                   DateTime?
  changedById               String?
  changedBy                 User?                     @relation("ProductPriceHistoryChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  note                      String?
  createdAt                 DateTime                  @default(now())
  lineItems                 OpportunityLineItem[]

  @@index([productId, validFrom])
  @@index([reason, validFrom])
  @@index([calculatedExchangeRateId])
  @@index([changedById])
  @@map("product_price_histories")
}

model OpportunityStageHistory {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  fromStageId String?
  fromStage   PipelineStage? @relation("OpportunityHistoryFromStage", fields: [fromStageId], references: [id])
  toStageId   String
  toStage     PipelineStage  @relation("OpportunityHistoryToStage", fields: [toStageId], references: [id])

  changedById String?
  changedBy   User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  note      String?
  changedAt DateTime @default(now())

  @@index([opportunityId])
  @@index([fromStageId])
  @@index([toStageId])
  @@index([changedAt])
  @@index([opportunityId, changedAt])
  @@map("opportunity_stage_histories")
}

model Task {
  id String @id @default(uuid())

  title       String
  description String?

  status   TaskStatus @default(TODO)
  priority Priority   @default(MEDIUM)

  dueAt      DateTime?
  reminderAt DateTime?

  assignmentScope TaskAssignmentScope @default(SELF)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  parentTaskId String?
  parentTask   Task?   @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: Restrict)
  subtasks     Task[]  @relation("TaskHierarchy")

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  commercialDocumentId String?
  commercialDocument   OpportunityCommercialDocument? @relation(fields: [commercialDocumentId], references: [id], onDelete: SetNull)

  paymentId String?
  payment   OpportunityPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  meetingId String?
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  activityId String?
  activity   Activity?  @relation("LegacyTaskActivity", fields: [activityId], references: [id], onDelete: SetNull)
  activities Activity[] @relation("TaskActivities")

  productId String?
  product   ProductCatalogItem? @relation(fields: [productId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   User?   @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  requiresReview Boolean           @default(false)
  reviewStatus   TaskReviewStatus  @default(NOT_REQUIRED)
  reviewerId     String?
  reviewer       User?             @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewRounds   TaskReviewRound[]

  createdById String?
  createdBy   User?   @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  completedAt    DateTime?
  completedById  String?
  completedBy    User?     @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  completionNote String?

  cancelledAt  DateTime?
  cancelReason String?

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  organizationId    String              @default("00000000-0000-4000-8000-000000000001")
  organization      Organization        @relation(fields: [organizationId], references: [id])
  TenderRequirement TenderRequirement[]

  @@index([status])
  @@index([priority])
  @@index([dueAt])
  @@index([reminderAt])
  @@index([companyId])
  @@index([personId])
  @@index([opportunityId])
  @@index([commercialDocumentId])
  @@index([paymentId])
  @@index([meetingId])
  @@index([activityId])
  @@index([productId])
  @@index([teamId])
  @@index([parentTaskId])
  @@index([organizationId, assignmentScope, status, dueAt])
  @@index([organizationId, teamId, status, dueAt])
  @@index([assignedToId])
  @@index([organizationId, reviewStatus, reviewerId])
  @@index([reviewerId])
  @@index([createdById])
  @@index([completedAt])
  @@index([assignedToId, status, dueAt])
  @@index([organizationId])
  @@index([organizationId, assignedToId, status, dueAt])
  @@map("tasks")
}

model ConversationThread {
  id             String                    @id @default(uuid())
  organizationId String
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     ConversationEntityType
  entityId       String
  status         ConversationThreadStatus  @default(OPEN)
  createdById    String
  createdBy      User                      @relation("ConversationThreadCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  messages       ConversationMessage[]
  participants   ConversationParticipant[]

  @@unique([organizationId, entityType, entityId])
  @@index([organizationId, status, updatedAt])
  @@index([createdById])
  @@map("conversation_threads")
}

model ConversationMessage {
  id              String                  @id @default(uuid())
  organizationId  String
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  threadId        String
  thread          ConversationThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId        String
  author          User                    @relation("ConversationMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  parentMessageId String?
  parentMessage   ConversationMessage?    @relation("ConversationMessageReplies", fields: [parentMessageId], references: [id], onDelete: Restrict)
  replies         ConversationMessage[]   @relation("ConversationMessageReplies")
  type            ConversationMessageType @default(COMMENT)
  body            String
  editedAt        DateTime?
  deletedAt       DateTime?
  deletedById     String?
  deletedBy       User?                   @relation("ConversationMessageDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([organizationId, threadId, createdAt])
  @@index([parentMessageId])
  @@index([authorId])
  @@map("conversation_messages")
}

model ConversationParticipant {
  threadId   String
  thread     ConversationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime?
  createdAt  DateTime           @default(now())

  @@id([threadId, userId])
  @@index([userId, lastReadAt])
  @@map("conversation_participants")
}

model TaskReviewRound {
  id             String               @id @default(uuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  taskId         String
  task           Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  roundNumber    Int
  reviewerId     String
  reviewer       User                 @relation("TaskReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  submittedById  String
  submittedBy    User                 @relation("TaskReviewSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt    DateTime             @default(now())
  submissionNote String?
  decision       TaskReviewDecision   @default(PENDING)
  reviewedAt     DateTime?
  reviewComment  String?
  artifacts      TaskReviewArtifact[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([taskId, roundNumber])
  @@index([organizationId, reviewerId, decision, submittedAt])
  @@index([taskId, submittedAt])
  @@map("task_review_rounds")
}

model TaskReviewArtifact {
  id            String          @id @default(uuid())
  reviewRoundId String
  reviewRound   TaskReviewRound @relation(fields: [reviewRoundId], references: [id], onDelete: Cascade)
  artifactId    String
  artifact      FileAttachment  @relation(fields: [artifactId], references: [id], onDelete: Restrict)
  addedById     String?
  addedBy       User?           @relation("TaskReviewArtifactAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())

  @@unique([reviewRoundId, artifactId])
  @@index([artifactId])
  @@map("task_review_artifacts")
}

model Meeting {
  id                 String            @id @default(uuid())
  organizationId     String
  organization       Organization      @relation(fields: [organizationId], references: [id])
  companyId          String
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  opportunityId      String?
  opportunity        Opportunity?      @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  title              String
  meetingTypeId      String
  type               LookupOption      @relation("MeetingTypeOption", fields: [meetingTypeId], references: [id], onDelete: Restrict)
  agenda             String?
  description        String?
  mode               MeetingMode
  location           String?
  meetingUrl         String?
  startAt            DateTime
  endAt              DateTime
  reminderAt         DateTime?
  reminderSentAt     DateTime?
  status             MeetingStatus     @default(SCHEDULED)
  organizerId        String
  organizer          User              @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  createdById        String
  createdBy          User              @relation("MeetingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  completedAt        DateTime?
  completedById      String?
  completedBy        User?             @relation("MeetingCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  completionNote     String?
  cancelledAt        DateTime?
  cancelledById      String?
  cancelledBy        User?             @relation("MeetingCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancellationReason String?
  assignees          MeetingAssignee[]
  attendees          MeetingAttendee[]
  tasks              Task[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([organizationId, startAt])
  @@index([companyId, startAt])
  @@index([opportunityId, startAt])
  @@index([organizerId, startAt])
  @@index([status, startAt])
  @@index([meetingTypeId, startAt])
  @@index([reminderAt, reminderSentAt, status])
  @@map("meetings")
}

model MeetingAssignee {
  meetingId    String
  meeting      Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation("MeetingAssignedUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedBy   User?    @relation("MeetingAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@id([meetingId, userId])
  @@index([userId])
  @@map("meeting_assignees")
}

model MeetingAttendee {
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([meetingId, personId])
  @@index([personId])
  @@map("meeting_attendees")
}

model Notification {
  id String @id @default(uuid())

  recipientId String
  recipient   User   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  type     NotificationType
  priority NotificationPriority @default(NORMAL)

  title String
  body  String?

  entityType NotificationEntityType?
  entityId   String?

  actionUrl String?
  metadata  Json?

  readAt     DateTime?
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String       @default("00000000-0000-4000-8000-000000000001")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([recipientId])
  @@index([actorId])
  @@index([type])
  @@index([priority])
  @@index([entityType, entityId])
  @@index([readAt])
  @@index([archivedAt])
  @@index([createdAt])
  @@index([recipientId, readAt, archivedAt, createdAt])
  @@index([organizationId])
  @@index([organizationId, recipientId, readAt, archivedAt, createdAt])
  @@map("notifications")
}


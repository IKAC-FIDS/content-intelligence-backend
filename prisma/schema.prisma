// Content Intelligence platform foundation

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

enum UserRole {
  ADMIN
  MANAGER
  REP
  BOARDS
}

enum PlatformRole {
  PLATFORM_ADMIN
}

enum RoleScope {
  SYSTEM
  TENANT
}

enum FeatureKey {
  SSO
  PASSKEY
  ADVANCED_RBAC
  CUSTOM_DOMAINS
  BRANDING
  AUDIT
  REPORTING
}

enum SubscriptionType {
  STANDARD
  TRIAL
  MANUAL_CONTRACT
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum EntitlementOverrideState {
  ENABLED
  DISABLED
}

enum QuotaMetric {
  ACTIVE_USERS
  FILES
  STORAGE_BYTES
  API_CALLS
  WORKFLOW_RUNS
  WEBHOOK_DELIVERIES
  EMAIL_SENDS
  AI_REQUESTS
}

enum QuotaResetPeriod {
  NONE
  DAILY
  MONTHLY
  SUBSCRIPTION_TERM
}

enum UsageReservationStatus {
  RESERVED
  COMMITTED
  RELEASED
  EXPIRED
}

enum SsoProviderType {
  OIDC
  SAML
}

enum SsoRoutingKind {
  DOMAIN
  SUBDOMAIN
}

enum AttachmentStorageProvider {
  LOCAL
  MINIO
}

enum ArtifactType {
  FILE
  EXTERNAL_URL
}

enum ArtifactProvider {
  LOCAL
  OBJECT_STORAGE
  GOOGLE_DRIVE
  SHAREPOINT
  ONEDRIVE
  GITHUB
  GENERIC_URL
}

enum OrganizationStatus {
  PENDING_SETUP
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationOnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  READY
  FAILED
}

enum OrganizationMembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum OrganizationCalendarSystem {
  GREGORIAN
  PERSIAN
}

enum OrganizationDateFormat {
  YYYY_MM_DD
  DD_MM_YYYY
  MM_DD_YYYY
}

enum OrganizationDomainType {
  SUBDOMAIN
  CUSTOM
}

enum OrganizationDomainStatus {
  PENDING
  VERIFIED
  FAILED
  DISABLED
}

enum OrganizationDomainVerificationMethod {
  DNS_TXT
}

// ============================================================
// Users & Auth
// ============================================================

model User {
  id                    String                     @id @default(uuid())
  fullName              String
  email                 String                     @unique
  passwordHash          String
  role                  UserRole                   @default(REP)
  roleId                String?
  assignedRole          Role?                      @relation(fields: [roleId], references: [id], onDelete: SetNull)
  team                  String?
  teamId                String?
  teamRef               Team?                      @relation("UserPrimaryTeam", fields: [teamId], references: [id], onDelete: SetNull)
  isActive              Boolean                    @default(true)
  avatarStorageProvider AttachmentStorageProvider?
  avatarBucket          String?
  avatarObjectKey       String?
  avatarStoragePath     String?
  avatarMimeType        String?
  avatarOriginalName    String?

  organizationId String       @default("00000000-0000-4000-8000-000000000001")
  organization   Organization @relation(fields: [organizationId], references: [id])

  passwordChangedAt   DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passkeys           UserPasskey[]
  externalIdentities ExternalIdentity[]
  ssoLoginTickets    SsoLoginTicket[]
  refreshSessions    RefreshSession[]

  managedTeams            Team[]                   @relation("TeamManager")
  organizationMemberships OrganizationMembership[]
  artifactsUploaded       FileAttachment[]         @relation("ArtifactUploadedBy")
  artifactsDeleted        FileAttachment[]         @relation("ArtifactDeletedBy")
  platformAuthority       PlatformAuthority?

  @@index([organizationId])
  @@index([teamId])
  @@index([roleId])
  @@map("users")
}

model Team {
  id          String  @id @default(uuid())
  code        String
  name        String
  description String?

  managerId String?
  manager   User?   @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  members                 User[]                       @relation("UserPrimaryTeam")
  organizationMemberships OrganizationMembership[]
  membershipLinks         OrganizationMembershipTeam[]

  @@unique([organizationId, code])
  @@index([managerId])
  @@index([isActive])
  @@index([organizationId])
  @@map("teams")
}

model Organization {
  id String @id @default(uuid())

  code String @unique
  name String

  status           OrganizationStatus           @default(ACTIVE)
  onboardingStatus OrganizationOnboardingStatus @default(NOT_STARTED)

  onboardingStartedAt      DateTime?
  onboardingCompletedAt    DateTime?
  onboardingLastAttemptAt  DateTime?
  onboardingFailureCode    String?
  onboardingFailureMessage String?

  timezone String @default("Asia/Tehran")
  locale   String @default("fa-IR")

  settings             Json?
  authorizationVersion Int   @default(1)
  entitlementVersion   Int   @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  teams               Team[]
  fileAttachments     FileAttachment[]
  auditLogs           AuditLog[]
  memberships         OrganizationMembership[]
  ssoProviders        SsoProvider[]
  ssoRoutes           SsoProviderRoute[]
  ssoAuthTransactions SsoAuthTransaction[]
  tenantSettings      OrganizationSettings?
  branding            OrganizationBranding?
  domains             OrganizationDomain[]
  tenantRoles         Role[]                      @relation("TenantRoles")
  subscriptions       Subscription[]
  entitlements        OrganizationEntitlement[]
  quotaOverrides      OrganizationQuotaOverride[]
  usageCounters       UsageCounter[]
  usageSnapshots      UsageSnapshot[]
  quotaThresholds     QuotaThresholdEvent[]
  usageReservations   UsageReservation[]
  usageEvents         UsageEvent[]

  @@index([status])
  @@index([createdAt])
  @@map("organizations")
}

model OrganizationSettings {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  timezone               String                     @default("Asia/Tehran")
  locale                 String                     @default("fa-IR")
  calendarSystem         OrganizationCalendarSystem @default(PERSIAN)
  dateFormat             OrganizationDateFormat     @default(YYYY_MM_DD)
  firstDayOfWeek         Int                        @default(6)
  emailSenderDisplayName String?
  smtpEnabled            Boolean                    @default(false)
  smtpHost               String?
  smtpPort               Int?
  smtpSecure             Boolean                    @default(true)
  smtpUsername           String?
  smtpPasswordEnc        String?
  smtpFromEmail          String?
  smtpFromName           String?
  smtpReplyTo            String?
  allowPasswordLogin     Boolean                    @default(true)
  allowPasskeyLogin      Boolean                    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organization_settings")
}

model OrganizationBranding {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  displayTitle        String?
  primaryColor        String?
  secondaryColor      String?
  accentColor         String?
  logoAttachmentId    String?
  faviconAttachmentId String?
  logoAttachment      FileAttachment? @relation("OrganizationBrandingLogo", fields: [logoAttachmentId], references: [id], onDelete: SetNull)
  faviconAttachment   FileAttachment? @relation("OrganizationBrandingFavicon", fields: [faviconAttachmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([logoAttachmentId])
  @@index([faviconAttachmentId])
  @@map("organization_branding")
}

model OrganizationDomain {
  id                    String                               @id @default(uuid())
  organizationId        String
  organization          Organization                         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type                  OrganizationDomainType
  hostname              String                               @unique
  subdomainLabel        String?                              @unique
  status                OrganizationDomainStatus             @default(PENDING)
  verificationMethod    OrganizationDomainVerificationMethod @default(DNS_TXT)
  verificationTokenHash String
  verifiedAt            DateTime?
  lastCheckedAt         DateTime?
  failureCode           String?
  createdAt             DateTime                             @default(now())
  updatedAt             DateTime                             @updatedAt

  @@index([organizationId, status])
  @@index([status, hostname])
  @@map("organization_domains")
}

model UserPasskey {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId         String    @unique
  credentialPublicKey  Bytes
  counter              Int       @default(0)
  deviceName           String?
  transports           String[]
  backedUp             Boolean   @default(false)
  credentialDeviceType String?
  lastUsedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
  @@map("user_passkeys")
}

model SsoProvider {
  id       String          @id @default(uuid())
  name     String
  type     SsoProviderType
  isActive Boolean         @default(true)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  normalizedName String?

  autoProvision  Boolean   @default(false)
  defaultRole    UserRole?
  allowedDomains String[]  @default([])

  // OIDC configuration
  issuer           String?
  clientId         String?
  clientSecretEnc  String?
  authorizationUrl String?
  tokenUrl         String?
  userInfoUrl      String?
  jwksUrl          String?
  scopes           String[] @default(["openid", "profile", "email"])

  // SAML configuration
  entityId             String?
  ssoUrl               String?
  x509Certificate      String?
  signRequests         Boolean @default(false)
  wantAssertionsSigned Boolean @default(true)
  wantResponseSigned   Boolean @default(false)

  // Attribute mapping
  emailAttribute  String?
  nameAttribute   String?
  groupsAttribute String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  externalIdentities ExternalIdentity[]
  loginTickets       SsoLoginTicket[]
  routes             SsoProviderRoute[]
  groupRoleMappings  SsoGroupRoleMapping[]
  authTransactions   SsoAuthTransaction[]

  @@unique([organizationId, type, normalizedName])
  @@unique([organizationId, issuer])
  @@unique([organizationId, clientId])
  @@unique([organizationId, entityId])
  @@index([type])
  @@index([isActive])
  @@index([organizationId, isActive])
  @@map("sso_providers")
}

model SsoProviderRoute {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerId     String
  provider       SsoProvider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  kind           SsoRoutingKind
  value          String
  createdAt      DateTime       @default(now())

  @@unique([kind, value])
  @@unique([providerId, kind, value])
  @@index([organizationId])
  @@index([providerId])
  @@map("sso_provider_routes")
}

model SsoGroupRoleMapping {
  id              String      @id @default(uuid())
  providerId      String
  provider        SsoProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  normalizedGroup String
  roleId          String
  role            Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([providerId, normalizedGroup])
  @@index([roleId])
  @@map("sso_group_role_mappings")
}

model SsoAuthTransaction {
  id              String       @id @default(uuid())
  stateHash       String       @unique
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerId      String
  provider        SsoProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  nonceEnc        String?
  pkceVerifierEnc String?
  redirectTarget  String
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime     @default(now())

  @@index([providerId, expiresAt])
  @@index([organizationId, expiresAt])
  @@index([consumedAt])
  @@map("sso_auth_transactions")
}

model ExternalIdentity {
  id         String @id @default(uuid())
  userId     String
  providerId String

  subject String
  email   String?

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider SsoProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, subject])
  @@index([userId])
  @@index([email])
  @@map("external_identities")
}

model SsoLoginTicket {
  id         String @id @default(uuid())
  ticketHash String @unique

  userId     String
  providerId String?

  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider SsoProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([providerId])
  @@index([expiresAt])
  @@index([consumedAt])
  @@map("sso_login_tickets")
}

model RefreshSession {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String @unique

  userAgent String?
  ipAddress String?

  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  revokedAt           DateTime?
  revokedReason       String?
  replacedBySessionId String?

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([userId, revokedAt, expiresAt])
  @@map("refresh_sessions")
}

enum AuditScope {
  TENANT
  PLATFORM
  SYSTEM
}

enum AuditActorType {
  USER
  PLATFORM_ADMIN
  ANONYMOUS
  SYSTEM
  LEGACY
}

enum AuditSource {
  WEB
  API
  AUTH
  BACKGROUND_JOB
  SCHEDULER
  PLATFORM
  SYSTEM
  LEGACY
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
  ERROR
  LEGACY
}

model AuditLog {
  id         String  @id @default(uuid())
  actorId    String?
  entityType String
  entityId   String?
  action     String
  before     Json?
  after      Json?
  metadata   Json?

  scope             AuditScope?
  actorType         AuditActorType?
  actorMembershipId String?
  source            AuditSource?
  result            AuditResult?
  durationMs        Int?
  errorCode         String?

  requestId     String?
  ipAddress     String?
  userAgent     String?
  requestMethod String?
  requestPath   String?

  createdAt DateTime @default(now())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([requestId])
  @@index([ipAddress])
  @@index([requestMethod])
  @@index([createdAt])
  @@index([organizationId])
  @@index([scope, createdAt])
  @@index([organizationId, scope, createdAt])
  @@index([actorMembershipId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([source, result, createdAt])
  @@map("audit_logs")
}

model AuditLogArchive {
  id                 String          @id @default(uuid())
  originalAuditLogId String          @unique
  scope              AuditScope?
  organizationId     String?
  actorId            String?
  actorType          AuditActorType?
  actorMembershipId  String?
  requestId          String?
  entityType         String
  entityId           String?
  action             String
  before             Json?
  after              Json?
  ipAddress          String?
  userAgent          String?
  requestMethod      String?
  requestPath        String?
  source             AuditSource?
  result             AuditResult?
  durationMs         Int?
  errorCode          String?
  metadata           Json?
  originalCreatedAt  DateTime
  archivedAt         DateTime        @default(now())
  archiveBatchId     String
  contentChecksum    String

  @@index([organizationId, scope, originalCreatedAt])
  @@index([archiveBatchId])
  @@map("audit_log_archives")
}

model AuditRetentionPolicy {
  id                  String     @id @default(uuid())
  scope               AuditScope
  organizationId      String?
  enabled             Boolean    @default(false)
  retentionDays       Int?
  archiveBeforeDelete Boolean    @default(true)
  updatedById         String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([scope, organizationId])
  @@index([enabled])
  @@map("audit_retention_policies")
}

// ============================================================
// ✅ جدید: مدیریت صنایع، نقاط درد و کاربردها (ماژولار)
// ============================================================

// ============================================================
// مدیریت دسترسی‌ها (Policy)
// ============================================================

model Permission {
  id          String   @id @default(uuid())
  action      String   @unique
  name        String?
  description String?
  group       String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id                      String                   @id @default(uuid())
  code                    String                   @unique
  name                    String
  description             String?
  baseRole                UserRole                 @default(REP)
  isSystem                Boolean                  @default(false)
  isActive                Boolean                  @default(true)
  scope                   RoleScope                @default(SYSTEM)
  organizationId          String?
  organization            Organization?            @relation("TenantRoles", fields: [organizationId], references: [id], onDelete: Restrict)
  normalizedCode          String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  users                   User[]
  permissions             RolePermission[]
  organizationMemberships OrganizationMembership[]
  ssoGroupMappings        SsoGroupRoleMapping[]

  @@unique([organizationId, normalizedCode])
  @@index([isActive])
  @@index([scope, organizationId, isActive])
  @@map("roles")
}

model OrganizationMembership {
  id             String                       @id @default(uuid())
  userId         String
  user           User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleId         String?
  role           Role?                        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  teamId         String?
  team           Team?                        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teams          OrganizationMembershipTeam[]
  status         OrganizationMembershipStatus @default(INVITED)
  isDefault      Boolean                      @default(false)
  isTenantOwner  Boolean                      @default(false)
  joinedAt       DateTime?
  invitedAt      DateTime?
  suspendedAt    DateTime?
  lastAccessAt   DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, isTenantOwner, status])
  @@index([userId, status])
  @@index([roleId])
  @@index([teamId])
  @@index([userId, isDefault, status])
  @@map("organization_memberships")
}

model OrganizationMembershipTeam {
  membershipId String
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt    DateTime               @default(now())

  @@id([membershipId, teamId])
  @@index([teamId])
  @@map("organization_membership_teams")
}

model PlatformAuthority {
  id        String       @id @default(uuid())
  userId    String       @unique
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      PlatformRole @default(PLATFORM_ADMIN)
  grantedAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([role])
  @@map("platform_authorities")
}

model RolePermission {
  id           String     @id @default(uuid())
  role         UserRole?
  roleId       String?
  assignedRole Role?      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([role, permissionId])
  @@unique([roleId, permissionId])
  @@index([roleId])
  @@map("role_permissions")
}

model Plan {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  revision    Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  features      PlanFeature[]
  quotas        PlanQuota[]
  subscriptions Subscription[]

  @@index([isActive])
  @@map("plans")
}

model PlanFeature {
  id        String     @id @default(uuid())
  planId    String
  plan      Plan       @relation(fields: [planId], references: [id], onDelete: Restrict)
  feature   FeatureKey
  enabled   Boolean    @default(false)
  value     Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([planId, feature])
  @@index([feature])
  @@map("plan_features")
}

model Subscription {
  id                String             @id @default(uuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  planId            String
  plan              Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  type              SubscriptionType
  status            SubscriptionStatus @default(PENDING)
  startAt           DateTime
  endAt             DateTime?
  gracePeriodEndAt  DateTime?
  contractReference String?
  internalNote      String?
  createdById       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([organizationId, status, startAt, endAt])
  @@index([planId])
  @@map("subscriptions")
}

model OrganizationEntitlement {
  id             String                   @id @default(uuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  feature        FeatureKey
  state          EntitlementOverrideState
  reason         String?
  createdById    String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([organizationId, feature])
  @@index([feature])
  @@map("organization_entitlements")
}

model PlanQuota {
  id          String           @id @default(uuid())
  planId      String
  plan        Plan             @relation(fields: [planId], references: [id], onDelete: Restrict)
  metric      QuotaMetric
  enabled     Boolean          @default(false)
  isUnlimited Boolean          @default(false)
  softLimit   BigInt?
  hardLimit   BigInt?
  resetPeriod QuotaResetPeriod @default(MONTHLY)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([planId, metric])
  @@index([metric])
  @@map("plan_quotas")
}

model OrganizationQuotaOverride {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  metric         QuotaMetric
  enabled        Boolean?
  isUnlimited    Boolean?
  softLimit      BigInt?
  hardLimit      BigInt?
  resetPeriod    QuotaResetPeriod?
  reason         String?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, metric])
  @@index([metric])
  @@map("organization_quota_overrides")
}

model UsageCounter {
  id                 String           @id @default(uuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  metric             QuotaMetric
  periodStart        DateTime
  periodEnd          DateTime?
  currentValue       BigInt           @default(0)
  effectiveSoftLimit BigInt?
  effectiveHardLimit BigInt?
  resetPeriod        QuotaResetPeriod
  configurationState String
  version            Int              @default(1)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  reservations UsageReservation[]

  @@unique([organizationId, metric, periodStart])
  @@index([organizationId, metric, periodEnd])
  @@map("usage_counters")
}

model UsageSnapshot {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  metric             QuotaMetric
  periodStart        DateTime
  periodEnd          DateTime?
  finalUsage         BigInt
  softLimit          BigInt?
  hardLimit          BigInt?
  percentageBasisPts Int?
  exceeded           Boolean
  capturedAt         DateTime     @default(now())

  @@unique([organizationId, metric, periodStart])
  @@index([organizationId, capturedAt])
  @@map("usage_snapshots")
}

model QuotaThresholdEvent {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  metric         QuotaMetric
  periodStart    DateTime
  threshold      Int
  usageValue     BigInt
  limitValue     BigInt
  createdAt      DateTime     @default(now())

  @@unique([organizationId, metric, periodStart, threshold])
  @@index([organizationId, createdAt])
  @@map("quota_threshold_events")
}

model UsageReservation {
  id             String                 @id @default(uuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  counterId      String
  counter        UsageCounter           @relation(fields: [counterId], references: [id], onDelete: Restrict)
  metric         QuotaMetric
  idempotencyKey String
  amount         BigInt
  status         UsageReservationStatus @default(RESERVED)
  expiresAt      DateTime?
  committedAt    DateTime?
  releasedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([organizationId, metric, idempotencyKey])
  @@index([organizationId, status, expiresAt])
  @@map("usage_reservations")
}

model UsageEvent {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  metric         QuotaMetric
  idempotencyKey String
  amount         BigInt
  periodStart    DateTime
  createdAt      DateTime     @default(now())

  @@unique([organizationId, metric, idempotencyKey])
  @@index([organizationId, metric, periodStart])
  @@map("usage_events")
}

model FileAttachment {
  id String @id @default(uuid())

  entityType String
  entityId   String

  type            ArtifactType              @default(FILE)
  provider        ArtifactProvider          @default(LOCAL)
  storageProvider AttachmentStorageProvider @default(LOCAL)

  name            String
  externalUrl     String?
  metadata        Json?
  category        String?
  tags            String[] @default([])
  versionLabel    String?
  confidentiality String?

  bucket      String?
  objectKey   String?
  storagePath String?

  originalFileName String?
  storedFileName   String?

  mimeType  String?
  sizeBytes Int?
  sha256    String?

  description String?

  uploadedById String?
  uploadedBy   User?     @relation("ArtifactUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  deletedAt    DateTime?
  deletedById  String?
  deletedBy    User?     @relation("ArtifactDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId      String                 @default("00000000-0000-4000-8000-000000000001")
  organization        Organization           @relation(fields: [organizationId], references: [id])
  brandingLogoUses    OrganizationBranding[] @relation("OrganizationBrandingLogo")
  brandingFaviconUses OrganizationBranding[] @relation("OrganizationBrandingFavicon")

  @@index([entityType, entityId])
  @@index([storageProvider])
  @@index([bucket])
  @@index([objectKey])
  @@index([uploadedById])
  @@index([sha256])
  @@index([deletedAt])
  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, type, provider, createdAt])
  @@index([organizationId, name])
  @@map("file_attachments")
}

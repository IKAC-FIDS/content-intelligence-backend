// ============================================================
// مدیریت دسترسی‌ها (Policy)
// ============================================================

model Permission {
  id          String   @id @default(uuid())
  action      String   @unique
  name        String?
  description String?
  group       String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id                      String                   @id @default(uuid())
  code                    String                   @unique
  name                    String
  description             String?
  baseRole                UserRole                 @default(REP)
  isSystem                Boolean                  @default(false)
  isActive                Boolean                  @default(true)
  scope                   RoleScope                @default(SYSTEM)
  organizationId          String?
  organization            Organization?            @relation("TenantRoles", fields: [organizationId], references: [id], onDelete: Restrict)
  normalizedCode          String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  users                   User[]
  permissions             RolePermission[]
  organizationMemberships OrganizationMembership[]
  ssoGroupMappings        SsoGroupRoleMapping[]

  @@unique([organizationId, normalizedCode])
  @@index([isActive])
  @@index([scope, organizationId, isActive])
  @@map("roles")
}

model OrganizationMembership {
  id             String                       @id @default(uuid())
  userId         String
  user           User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleId         String?
  role           Role?                        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  teamId         String?
  team           Team?                        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  status         OrganizationMembershipStatus @default(INVITED)
  isDefault      Boolean                      @default(false)
  isTenantOwner  Boolean                      @default(false)
  joinedAt       DateTime?
  invitedAt      DateTime?
  suspendedAt    DateTime?
  lastAccessAt   DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, isTenantOwner, status])
  @@index([userId, status])
  @@index([roleId])
  @@index([teamId])
  @@index([userId, isDefault, status])
  @@map("organization_memberships")
}

model PlatformAuthority {
  id        String       @id @default(uuid())
  userId    String       @unique
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      PlatformRole @default(PLATFORM_ADMIN)
  grantedAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([role])
  @@map("platform_authorities")
}

model RolePermission {
  id           String     @id @default(uuid())
  role         UserRole?
  roleId       String?
  assignedRole Role?      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([role, permissionId])
  @@unique([roleId, permissionId])
  @@index([roleId])
  @@map("role_permissions")
}

model Plan {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  revision    Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  features      PlanFeature[]
  quotas        PlanQuota[]
  subscriptions Subscription[]

  @@index([isActive])
  @@map("plans")
}

model PlanFeature {
  id        String     @id @default(uuid())
  planId    String
  plan      Plan       @relation(fields: [planId], references: [id], onDelete: Restrict)
  feature   FeatureKey
  enabled   Boolean    @default(false)
  value     Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([planId, feature])
  @@index([feature])
  @@map("plan_features")
}

model Subscription {
  id                String             @id @default(uuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  planId            String
  plan              Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  type              SubscriptionType
  status            SubscriptionStatus @default(PENDING)
  startAt           DateTime
  endAt             DateTime?
  gracePeriodEndAt  DateTime?
  contractReference String?
  internalNote      String?
  createdById       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([organizationId, status, startAt, endAt])
  @@index([planId])
  @@map("subscriptions")
}

model OrganizationEntitlement {
  id             String                   @id @default(uuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  feature        FeatureKey
  state          EntitlementOverrideState
  reason         String?
  createdById    String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([organizationId, feature])
  @@index([feature])
  @@map("organization_entitlements")
}

model PlanQuota {
  id          String           @id @default(uuid())
  planId      String
  plan        Plan             @relation(fields: [planId], references: [id], onDelete: Restrict)
  metric      QuotaMetric
  enabled     Boolean          @default(false)
  isUnlimited Boolean          @default(false)
  softLimit   BigInt?
  hardLimit   BigInt?
  resetPeriod QuotaResetPeriod @default(MONTHLY)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([planId, metric])
  @@index([metric])
  @@map("plan_quotas")
}

model OrganizationQuotaOverride {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  metric         QuotaMetric
  enabled        Boolean?
  isUnlimited    Boolean?
  softLimit      BigInt?
  hardLimit      BigInt?
  resetPeriod    QuotaResetPeriod?
  reason         String?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, metric])
  @@index([metric])
  @@map("organization_quota_overrides")
}

model UsageCounter {
  id                 String           @id @default(uuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  metric             QuotaMetric
  periodStart        DateTime
  periodEnd          DateTime?
  currentValue       BigInt           @default(0)
  effectiveSoftLimit BigInt?
  effectiveHardLimit BigInt?
  resetPeriod        QuotaResetPeriod
  configurationState String
  version            Int              @default(1)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  reservations UsageReservation[]

  @@unique([organizationId, metric, periodStart])
  @@index([organizationId, metric, periodEnd])
  @@map("usage_counters")
}

model UsageSnapshot {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  metric             QuotaMetric
  periodStart        DateTime
  periodEnd          DateTime?
  finalUsage         BigInt
  softLimit          BigInt?
  hardLimit          BigInt?
  percentageBasisPts Int?
  exceeded           Boolean
  capturedAt         DateTime     @default(now())

  @@unique([organizationId, metric, periodStart])
  @@index([organizationId, capturedAt])
  @@map("usage_snapshots")
}

model QuotaThresholdEvent {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  metric         QuotaMetric
  periodStart    DateTime
  threshold      Int
  usageValue     BigInt
  limitValue     BigInt
  createdAt      DateTime     @default(now())

  @@unique([organizationId, metric, periodStart, threshold])
  @@index([organizationId, createdAt])
  @@map("quota_threshold_events")
}

model UsageReservation {
  id             String                 @id @default(uuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  counterId      String
  counter        UsageCounter           @relation(fields: [counterId], references: [id], onDelete: Restrict)
  metric         QuotaMetric
  idempotencyKey String
  amount         BigInt
  status         UsageReservationStatus @default(RESERVED)
  expiresAt      DateTime?
  committedAt    DateTime?
  releasedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([organizationId, metric, idempotencyKey])
  @@index([organizationId, status, expiresAt])
  @@map("usage_reservations")
}

model UsageEvent {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  metric         QuotaMetric
  idempotencyKey String
  amount         BigInt
  periodStart    DateTime
  createdAt      DateTime     @default(now())

  @@unique([organizationId, metric, idempotencyKey])
  @@index([organizationId, metric, periodStart])
  @@map("usage_events")
}

model FileAttachment {
  id String @id @default(uuid())

  entityType FileAttachmentEntityType
  entityId   String

  type            ArtifactType              @default(FILE)
  provider        ArtifactProvider          @default(LOCAL)
  storageProvider AttachmentStorageProvider @default(LOCAL)

  name            String
  externalUrl     String?
  metadata        Json?
  category        String?
  tags            String[] @default([])
  versionLabel    String?
  confidentiality String?

  bucket      String?
  objectKey   String?
  storagePath String?

  originalFileName String?
  storedFileName   String?

  mimeType  String?
  sizeBytes Int?
  sha256    String?

  description String?

  uploadedById String?
  uploadedBy   User?     @relation("ArtifactUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  deletedAt    DateTime?
  deletedById  String?
  deletedBy    User?     @relation("ArtifactDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId            String                     @default("00000000-0000-4000-8000-000000000001")
  organization              Organization               @relation(fields: [organizationId], references: [id])
  brandingLogoUses          OrganizationBranding[]     @relation("OrganizationBrandingLogo")
  brandingFaviconUses       OrganizationBranding[]     @relation("OrganizationBrandingFavicon")

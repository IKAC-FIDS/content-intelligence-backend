model NotificationEvent {
  id             String                 @id @default(uuid())
  organizationId String
  organization   Organization           @relation("NotificationCoreEvents", fields: [organizationId], references: [id], onDelete: Cascade)
  eventName      String
  aggregateType  String
  aggregateId    String
  actorId        String?
  actor          User?                  @relation("NotificationCoreEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  payload        Json                   @default("{}")
  idempotencyKey String?
  occurredAt     DateTime               @default(now())
  createdAt      DateTime               @default(now())
  deliveries     NotificationDelivery[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, eventName, occurredAt])
  @@index([aggregateType, aggregateId])
  @@index([actorId])
  @@map("notification_events")
}

model NotificationRule {
  id               String                      @id @default(uuid())
  organizationId   String
  organization     Organization                @relation("NotificationCoreRules", fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  eventName        String
  enabled          Boolean                     @default(true)
  mandatory        Boolean                     @default(false)
  priority         Int                         @default(100)
  deliveryPriority NotificationPriority        @default(NORMAL)
  digestPolicyId   String?
  digestPolicy     NotificationDigestPolicy?   @relation(fields: [digestPolicyId], references: [id], onDelete: SetNull)
  conditions       Json?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  recipientRules   NotificationRecipientRule[]
  deliveries       NotificationDelivery[]
  schedule         NotificationSchedule?

  @@index([organizationId, eventName, enabled])
  @@index([digestPolicyId])
  @@map("notification_rules")
}

model NotificationSchedule {
  id                 String                          @id @default(uuid())
  organizationId     String
  organization       Organization                    @relation("NotificationSchedules", fields: [organizationId], references: [id], onDelete: Cascade)
  ruleId             String                          @unique
  rule               NotificationRule                @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  enabled            Boolean                         @default(true)
  scheduleType       NotificationScheduleType
  sourceField        String
  offsetMinutes      Int                             @default(0)
  triggerMode        NotificationScheduleTriggerMode
  gracePeriodMinutes Int                             @default(60)
  lastEvaluatedAt    DateTime?
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt

  @@index([organizationId, enabled])
  @@index([organizationId, scheduleType, enabled])
  @@map("notification_schedules")
}

model NotificationRecipientRule {
  id         String                    @id @default(uuid())
  ruleId     String
  rule       NotificationRule          @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  type       NotificationRecipientType
  targetId   String?
  channels   NotificationChannel[]
  enabled    Boolean                   @default(true)
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt
  deliveries NotificationDelivery[]

  @@index([ruleId, enabled])
  @@index([type, targetId])
  @@map("notification_recipient_rules")
}

model NotificationTemplate {
  id             String                 @id @default(uuid())
  organizationId String
  organization   Organization           @relation("NotificationCoreTemplates", fields: [organizationId], references: [id], onDelete: Cascade)
  eventName      String
  channel        NotificationChannel
  locale         String                 @default("fa-IR")
  subject        String?
  body           String
  isActive       Boolean                @default(true)
  version        Int                    @default(1)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deliveries     NotificationDelivery[]

  @@unique([organizationId, eventName, channel, locale, version])
  @@index([organizationId, eventName, channel, isActive])
  @@map("notification_templates")
}

model NotificationDelivery {
  id                  String                        @id @default(uuid())
  organizationId      String
  organization        Organization                  @relation("NotificationCoreDeliveryOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  eventId             String
  event               NotificationEvent             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ruleId              String?
  rule                NotificationRule?             @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  recipientRuleId     String?
  recipientRule       NotificationRecipientRule?    @relation(fields: [recipientRuleId], references: [id], onDelete: SetNull)
  recipientUserId     String?
  recipientUser       User?                         @relation("NotificationCoreDeliveryRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)
  templateId          String?
  template            NotificationTemplate?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  channel             NotificationChannel
  status              NotificationDeliveryStatus    @default(PENDING)
  priority            NotificationPriority          @default(NORMAL)
  orchestrationReason String?
  deferredUntil       DateTime?
  digestBucketId      String?
  digestBucket        NotificationDigestBucket?     @relation(fields: [digestBucketId], references: [id], onDelete: SetNull)
  escalationRunId     String?
  escalationRun       NotificationEscalationRun?    @relation(fields: [escalationRunId], references: [id], onDelete: SetNull)
  destination         String?
  deduplicationKey    String
  attemptCount        Int                           @default(0)
  providerMessageId   String?
  failureCode         String?
  failureMessage      String?
  lastAttemptAt       DateTime?
  nextAttemptAt       DateTime?
  processingStartedAt DateTime?
  retryRequestedAt    DateTime?
  retryRequestedById  String?
  retryRequestedBy    User?                         @relation("NotificationDeliveryRetryRequestedBy", fields: [retryRequestedById], references: [id], onDelete: SetNull)
  sentAt              DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  attempts            NotificationDeliveryAttempt[]

  @@unique([organizationId, deduplicationKey])
  @@index([eventId])
  @@index([organizationId, status, createdAt])
  @@index([ruleId])
  @@index([recipientUserId, status, createdAt])
  @@index([channel, status, createdAt])
  @@index([status, nextAttemptAt, createdAt])
  @@index([status, processingStartedAt])
  @@index([retryRequestedById])
  @@index([organizationId, deferredUntil])
  @@index([digestBucketId])
  @@index([escalationRunId])
  @@map("notification_deliveries")
}

model NotificationDeliveryAttempt {
  id                String                       @id @default(uuid())
  organizationId    String
  organization      Organization                 @relation("NotificationDeliveryAttemptOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  deliveryId        String
  delivery          NotificationDelivery         @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  attemptNumber     Int
  triggerType       NotificationTriggerType
  triggeredByUserId String?
  triggeredByUser   User?                        @relation("NotificationDeliveryAttemptTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  status            NotificationDeliveryStatus
  provider          String?
  providerMessageId String?
  failureCategory   NotificationFailureCategory?
  failureCode       String?
  failureReason     String?
  startedAt         DateTime
  finishedAt        DateTime?
  createdAt         DateTime                     @default(now())

  @@unique([deliveryId, attemptNumber])
  @@index([organizationId, createdAt])
  @@index([organizationId, deliveryId, createdAt])
  @@index([triggeredByUserId])
  @@map("notification_delivery_attempts")
}

model NotificationPreference {
  id             String              @id @default(uuid())
  organizationId String
  organization   Organization        @relation("NotificationCorePreferences", fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation("NotificationCorePreferences", fields: [userId], references: [id], onDelete: Cascade)
  eventName      String
  channel        NotificationChannel
  enabled        Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([organizationId, userId, eventName, channel])
  @@index([userId, eventName])
  @@map("notification_preferences")
}

model NotificationSmsSettings {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String
  apiUrl         String
  apiKeyEnc      String?
  senderNumber   String
  enabled        Boolean      @default(false)
  timeoutMs      Int          @default(10000)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, enabled])
  @@map("notification_sms_settings")
}

enum NotificationPushEndpointType {
  WEB
  ANDROID
  IOS
  OTHER
}

model NotificationPushSettings {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String       @default("WEB_PUSH")
  publicKey      String?
  privateKeyEnc  String?
  subject        String?
  enabled        Boolean      @default(false)
  timeoutMs      Int          @default(10000)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, enabled])
  @@map("notification_push_settings")
}

model NotificationPushEndpoint {
  id                 String                       @id @default(uuid())
  organizationId     String
  organization       Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId             String
  user               User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           String                       @default("WEB_PUSH")
  endpointType       NotificationPushEndpointType @default(WEB)
  externalEndpointId String
  endpointEnc        String
  metadata           Json?
  active             Boolean                      @default(true)
  lastSeenAt         DateTime                     @default(now())
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  @@unique([organizationId, provider, externalEndpointId])
  @@index([organizationId])
  @@index([organizationId, userId, provider, active])
  @@map("notification_push_endpoints")
}

model NotificationQuietHoursPolicy {
  id             String                     @id @default(uuid())
  organizationId String                     @unique
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enabled        Boolean                    @default(false)
  startTime      String                     @default("22:00")
  endTime        String                     @default("07:00")
  timezone       String                     @default("Asia/Tehran")
  channels       NotificationChannel[]
  allowCritical  Boolean                    @default(true)
  mode           NotificationQuietHoursMode @default(DEFER)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([organizationId, enabled])
  @@map("notification_quiet_hours_policies")
}

model NotificationDigestPolicy {
  id              String                      @id @default(uuid())
  organizationId  String
  organization    Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  enabled         Boolean                     @default(true)
  frequency       NotificationDigestFrequency @default(DAILY)
  sendTime        String
  timezone        String                      @default("Asia/Tehran")
  subjectTemplate String                      @default("خلاصه اعلان‌های روزانه")
  introText       String                      @default("خلاصه اعلان‌های شما:")
  eventNames      String[]
  channels        NotificationChannel[]
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  rules           NotificationRule[]
  buckets         NotificationDigestBucket[]

  @@index([organizationId, enabled])
  @@map("notification_digest_policies")
}

model NotificationDigestBucket {
  id                String                         @id @default(uuid())
  organizationId    String
  organization      Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  policyId          String
  policy            NotificationDigestPolicy       @relation(fields: [policyId], references: [id], onDelete: Cascade)
  recipientUserId   String
  channel           NotificationChannel
  windowStart       DateTime
  scheduledFor      DateTime
  status            NotificationDigestBucketStatus @default(OPEN)
  carrierDeliveryId String?                        @unique
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  items             NotificationDigestItem[]
  deliveries        NotificationDelivery[]

  @@unique([organizationId, policyId, recipientUserId, channel, windowStart])
  @@index([organizationId, status, scheduledFor])
  @@map("notification_digest_buckets")
}

model NotificationDigestItem {
  id         String                   @id @default(uuid())
  bucketId   String
  bucket     NotificationDigestBucket @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  deliveryId String                   @unique
  eventId    String
  createdAt  DateTime                 @default(now())

  @@index([bucketId, createdAt])
  @@map("notification_digest_items")
}

model NotificationEscalationPolicy {
  id             String                       @id @default(uuid())
  organizationId String
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  enabled        Boolean                      @default(true)
  eventName      String
  aggregateType  String                       @default("TASK")
  conditions     Json?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  steps          NotificationEscalationStep[]
  runs           NotificationEscalationRun[]

  @@index([organizationId, eventName, enabled])
  @@map("notification_escalation_policies")
}

model NotificationEscalationStep {
  id            String                       @id @default(uuid())
  policyId      String
  policy        NotificationEscalationPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  stepOrder     Int
  delayMinutes  Int
  recipientType NotificationRecipientType
  targetId      String?
  channels      NotificationChannel[]
  priority      NotificationPriority         @default(HIGH)
  mandatory     Boolean                      @default(true)
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  runs          NotificationEscalationRun[]

  @@unique([policyId, stepOrder])
  @@index([policyId, delayMinutes])
  @@map("notification_escalation_steps")
}

model NotificationEscalationRun {
  id             String                          @id @default(uuid())
  organizationId String
  organization   Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  policyId       String
  policy         NotificationEscalationPolicy    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  stepId         String
  step           NotificationEscalationStep      @relation(fields: [stepId], references: [id], onDelete: Cascade)
  sourceEventId  String
  aggregateType  String
  aggregateId    String
  sourceDueAt    DateTime?
  scheduledFor   DateTime
  status         NotificationEscalationRunStatus @default(PENDING)
  resolvedAt     DateTime?
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt
  deliveries     NotificationDelivery[]

  @@unique([organizationId, sourceEventId, stepId])
  @@index([organizationId, status, scheduledFor])
  @@index([aggregateType, aggregateId])
  @@map("notification_escalation_runs")
}
